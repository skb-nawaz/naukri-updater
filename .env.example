# Copy this file to .env and fill via: npm run encrypt:creds -- --email YOU --password PWD --save
# NEVER commit .env to git (.env is gitignored)

# 64-hex-char key for AES-256-GCM (generate: npm run encrypt:key)
ENCRYPTION_KEY=generate-me-with-npm-run-encrypt-key

# Encrypted Naukri login (preferred). Plaintext NAUKRI_EMAIL / NAUKRI_PASSWORD
# are still accepted as fallback but will be removed when you use --save.
NAUKRI_EMAIL_ENCRYPTED=
NAUKRI_PASSWORD_ENCRYPTED=

# What to set as the new Resume Headline.
# Leave empty to use the "touch/bump" strategy (re-save existing headline)
NAUKRI_NEW_HEADLINE=

# Optional: rotate headlines daily (true/false)
HEADLINE_ROTATE=false

# Run headed (to solve CAPTCHA manually) or headless
# headed = HEADLESS=false | headless = HEADLESS=true
HEADLESS=false

# Slow down actions by ms (helps avoid bot detection)
SLOW_MO=0
